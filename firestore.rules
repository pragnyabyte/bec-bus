rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Student passes: Public read and registration pass creation
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 2. Driver fleet records: Public read and registration creation
    match /drivers/{driverId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 3. Transit Routes & Timetables: Public read for student/driver navigation
    match /routes/{routeId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.code != null;
    }

    // 4. Live Buses & GPS Telemetry: Public read for live map tracking
    match /buses/{busId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Student Grievances & Complaints
    match /complaints/{complaintId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // 6. Route Change Requests
    match /change_requests/{requestId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // 7. Campus Broadcast Notifications & Alerts
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
