rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Student passes: Public read, registration pass creation, update, and deletion by college admin
    match /students/{studentId} {
      allow read, create, update, delete: if true;
    }

    // 2. Driver fleet records: Public read, registration creation, update, and deletion
    match /drivers/{driverId} {
      allow read, create, update, delete: if true;
    }

    // 3. Transit Routes & Timetables: Public read for student/driver navigation
    match /routes/{routeId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Live Buses & GPS Telemetry: Public read for live map tracking, driver updates
    match /buses/{busId} {
      allow read, write: if true;
    }

    // 5. Student Grievances & Complaints
    match /complaints/{complaintId} {
      allow read, create, update, delete: if true;
    }

    // 6. Route Change Requests
    match /change_requests/{requestId} {
      allow read, create, update, delete: if true;
    }

    // 7. Campus Broadcast Notifications & Alerts
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Default fallback: Reject unauthorized access to any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
